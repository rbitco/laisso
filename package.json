{
  "name": "lasso",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drives a Ticket through a Pipeline of Stages using a coding-agent Runner.",
  "bin": {
    "lasso": "bin/lasso.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "vite build --logLevel warn && node bin/lasso.js",
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.0",
    "vitest": "^3.1.0"
  }
}
