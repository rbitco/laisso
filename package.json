{
  "name": "@rbitco/lasso",
  "version": "0.0.0-dev",
  "type": "module",
  "description": "Drives a Ticket through a Pipeline of Stages using a coding-agent Runner.",
  "bin": {
    "lasso": "dist/lasso.js"
  },
  "files": [
    "dist/lasso.js",
    "dist/lasso.js.map",
    "dist/dashboard"
  ],
  "publishConfig": {
    "registry": "https://npm.matty.rocks/"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "vite build --logLevel warn && node bin/lasso.js",
    "build": "vite build",
    "bundle": "esbuild bin/lasso.js --bundle --platform=node --format=esm --target=node24 --packages=external --sourcemap --outfile=dist/lasso.js --log-level=warning",
    "prepack": "npm run typecheck && npm run build && npm run bundle",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^27.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.0",
    "vitest": "^3.1.0"
  }
}
